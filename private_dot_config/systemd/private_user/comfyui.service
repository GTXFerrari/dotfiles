[Unit]
Description=ComfyUI via uv
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/mnt/data/AI/image_gen/ComfyUI

[Service]
Type=simple
WorkingDirectory=/mnt/data/AI/image_gen/ComfyUI

# Use the venv/project env from the ComfyUI directory
ExecStart=/usr/bin/uv run --no-sync python main.py --listen 0.0.0.0 --port 8188 --enable-manager

Restart=on-failure
RestartSec=5

# Optional, but useful if HF/Comfy nodes use caches
Environment=HF_HOME=%h/.cache/huggingface
Environment=TRANSFORMERS_CACHE=%h/.cache/huggingface/transformers

[Install]
WantedBy=default.target
