# Use Ctrl+s as the prefix. Press it twice to send Ctrl+s to the pane.
set -g prefix C-s
unbind C-b
bind C-s send-prefix

# Start window and pane numbering at 1.
set -g base-index 1
setw -g pane-base-index 1

# Load colors generated by Noctalia.

# Rounded borders for menus and popups.
set -g menu-border-lines rounded
set -g popup-border-lines rounded

{{ if eq .chezmoi.os "linux" -}}
# Rounded session and title/clock segments using Noctalia's live palette.
set -g status-left-length 32
set -g status-right-length 64
set -g status-left ' #[fg=#{@noctalia_primary},bg=#{@noctalia_surface_container_low},nobold]#[fg=#{@noctalia_on_primary},bg=#{@noctalia_primary},bold] #S #[fg=#{@noctalia_primary},bg=#{@noctalia_surface_container_low},nobold] '
set -g status-right '#[fg=#{@noctalia_surface_container},bg=#{@noctalia_surface_container_low},nobold]#[fg=#{@noctalia_on_surface_variant},bg=#{@noctalia_surface_container}] #{?window_bigger,[#{window_offset_x}#,#{window_offset_y}] ,}"#{=21:pane_title}" %H:%M %d-%b-%y #[fg=#{@noctalia_surface_container},bg=#{@noctalia_surface_container_low}] '

# Match window pill edges to the active, activity, and bell colors.
set -g @rounded_window_bg '#{?window_bell_flag,#{@noctalia_error_container},#{?#{||:#{window_activity_flag},#{window_silence_flag}},#{@noctalia_tertiary_container},#{?window_active,#{@noctalia_surface_container_highest},#{?#{==:#{@noctalia_inactive_tabs_use_background},off},#{@noctalia_surface_container_low},#{@noctalia_surface_container}}}}}'
set -g window-status-format '#[fg=#{E:@rounded_window_bg},bg=#{@noctalia_surface_container_low},nobold]#[default] #I:#W#F #[fg=#{E:@rounded_window_bg},bg=#{@noctalia_surface_container_low},nobold]'
set -g window-status-current-format '#{E:window-status-format}'
source-file -q "$XDG_CONFIG_HOME/tmux/themes/noctalia.conf"
{{ else -}}
# Use the terminal's palette when Noctalia is unavailable.
set -g status-left ' #S '
set -g status-right ' %H:%M %d-%b-%y '
{{ end -}}
