# Options
setopt autocd # Automatically cd into typed dir
setopt interactive_comments
setopt SHARE_HISTORY
HISTSIZE=10000000
SAVEHIST=10000000
HISTFILE=$HOME/.config/.zhistory
setopt HIST_EXPIRE_DUPS_FIRST

# Use neovim for vim if present
(( $+commands[nvim] )) && alias vim='nvim' vimdiff='nvim -d'

# Vim Bindings
bindkey -v
export KEYTIMEOUT=1

# Completions
autoload -U compinit
zstyle ':completions:*' menu select
zmodload zsh/complist
compinit
_comp_options+=(globdots) # Include hidden files
autoload -U +X bashcompinit && bashcompinit

# Environment Variables
export BROWSER='firefox'
export EDITOR='nvim'
export TERMINAL='kitty'

#PATH
path+=("$HOME/.local/bin/")
path+=("$HOME/.cargo/bin/")
path+=("$HOME/.local/bin/scripts/")
export PATH

# Starship
export STARSHIP_CONFIG=~/.config/starship/starship.toml

## {Alias} ##

# General shortcuts
alias \
	e='$EDITOR' \
	v='$EDITOR' \
	cls='clear' \
	ll='ls -al' \
	la='ls -al' \
{{ if eq .chezmoi.os "darwin" -}}
  rm='rm -vi' \
{{ else -}}
  rm='rm -vI' \
{{ end -}}
  mv='mv -iv' \
  cp='cp -iv' \
  mkdir='mkdir -pv' \

# Git
alias \
	gb='git branch' \
	gc='git checkout' \
	ga='git add .' \
	gcom='git commit -m' \
	gd='git diff' \
	gs='git status' \
  lg='lazygit' \

# Make
alias \
	smci='sudo make clean install' \
	smcu='sudo make clean uninstall' \

{{ if eq .chezmoi.os "linux" -}}
# Grub (Arch only)
alias \
	grubin='sudo grub-install --target=x86_64-efi --efi-directory=/boot --bootloader=GRUB' \
	grubup='sudo grub-mkconfig -o /boot/grub/grub.cfg' \

# Mkinitcpio (Arch only)
alias \
	initram='sudo mkinitcpio -P' \

# Package Managers
#APT
alias \
	aptin='sudo apt-get install' \
	aptrm='sudo apt-get remove' \
	aptref='sudo apt-get update' \
	aptup='sudo apt-get upgrade' \
#Pacman
alias \
	pacin='sudo pacman -S' \
	pacrm='sudo pacman -Rs' \
	pacref='sudo pacman -Syy' \
	pacup='sudo pacman -Syu' \
  reflec='sudo reflector -c "United States" -a 12 -p https --sort rate --save /etc/pacman.d/mirrorlist' \

{{ end -}}
# Colorize
alias \
{{ if eq .chezmoi.os "darwin" -}}
	ls='ls -hG' \
	grep='grep --color=auto'
{{ else -}}
	ls='ls -hN --color=auto --group-directories-first' \
	grep='grep --color=auto' \
	diff='diff --color=auto' \
	ip='ip --color=auto' \

{{ end -}}
# Programs
alias \
	ff='fastfetch' \
  mus='ncmpcpp' \
  ytdl='yt-dlp' \
  hb='ghb' \
  hbcli='HandBrakeCLI' \
  s='kitten ssh' \
  nano='nvim' \
  vim='nvim' \
  tf='terraform'
  


{{ if eq .chezmoi.os "linux" -}}
# Easyeffects
alias \
	LCD2='easyeffects -l LCD2' \
	JBL='easyeffects -l JBL' \

{{ end -}}
# Python VENV
alias \
  comfy='source ~/Code/Python/VENV/comfyui/bin/activate' \

# Chezmoi
alias \
  cs='chezmoi status' \
  ccd='chezmoi cd' \
  cm='chezmoi merge' \

# Docker
alias \
  dcu='docker compose up -d' \
  dcd='docker compose down' \

{{ if eq .chezmoi.os "linux" -}}
alias \
  sunon='hyprctl output create headless HEADLESS-2' \
  sunoff='hyprctl output remove HEADLESS-2' \

alias noctalia-start='hyprctl dispatch '\''hl.dsp.exec_cmd("noctalia --daemon")'\'''

# SSH Hypr Session
alias grab-session='
  export $(systemctl --user show-environment | xargs)
  export HYPRLAND_INSTANCE_SIGNATURE=$(ls /run/user/1000/hypr/ | tail -1)
'

{{ end -}}
# Govc
govc-vcenter() { set -a; source ~/.config/govc/vcenter.env; set +a; }
govc-esxi() { set -a; source ~/.config/govc/esxi.env; set +a; }

# Source Plugins
{{ if eq .chezmoi.os "darwin" -}}
if (( $+commands[brew] )); then
  zsh_plugin_prefix="$(brew --prefix)"
  [[ -r "$zsh_plugin_prefix/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh" ]] && \
    source "$zsh_plugin_prefix/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
  [[ -r "$zsh_plugin_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
    source "$zsh_plugin_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  unset zsh_plugin_prefix
fi
{{ else -}}
[[ -r /usr/share/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh ]] && \
  source /usr/share/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
{{ end }}
(( $+commands[starship] )) && eval "$(starship init zsh)"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# Added by cua-driver-rs installer — see https://github.com/trycua/cua
export PATH="$HOME/.local/bin:$PATH"
