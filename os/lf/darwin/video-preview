#!/usr/bin/env python3
"""Print the path to a small cached animation for an lf video preview."""

import hashlib
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile


FILTER = (
    "[0:v]"
    "scale=w='min(960,iw)':h='min(720,ih)':"
    "force_original_aspect_ratio=decrease:flags=lanczos,split[v][p];"
    "[p]palettegen=max_colors=128:stats_mode=diff[pal];"
    "[v][pal]paletteuse=dither=bayer:bayer_scale=3[out]"
)
CACHE_LIMIT = 128 * 1024 * 1024


def interrupted(_signum, _frame):
    # subprocess.run also kills its child when this interrupts communicate().
    raise SystemExit(1)


def trim_cache(cache, keep):
    entries = []
    for entry in cache.glob("*.gif"):
        try:
            info = entry.stat()
            entries.append((info.st_mtime_ns, info.st_size, entry))
        except OSError:
            continue
    total = sum(size for _, size, _ in entries)
    for _, size, entry in sorted(entries):
        if total <= CACHE_LIMIT:
            break
        if entry != keep:
            try:
                entry.unlink()
                total -= size
            except OSError:
                pass


def main():
    if len(sys.argv) != 2:
        return 1
    source = Path(sys.argv[1]).resolve(strict=True)
    info = source.stat()
    signature = f"v2:5s:source-fps:{FILTER}:{source}:{info.st_size}:{info.st_mtime_ns}"
    key = hashlib.sha256(os.fsencode(signature)).hexdigest()
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    cache = cache / "lf" / "animated-previews"
    cache.mkdir(mode=0o700, parents=True, exist_ok=True)
    destination = cache / f"{key}.gif"
    if destination.is_file() and destination.stat().st_size:
        os.utime(destination, None)
        print(destination)
        return 0

    with tempfile.NamedTemporaryFile(dir=cache, prefix=".tmp-", suffix=".gif", delete=False) as handle:
        temporary = Path(handle.name)
    try:
        subprocess.run(
            [
                "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-y",
                "-threads", "2", "-t", "5", "-i", str(source),
                "-an", "-sn", "-dn", "-filter_complex_threads", "1",
                "-filter_complex", FILTER, "-map", "[out]", "-fps_mode", "passthrough",
                "-loop", "0", "-f", "gif", str(temporary),
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True,
            timeout=8,
        )
        if not temporary.stat().st_size:
            return 1
        temporary.replace(destination)
        trim_cache(cache, destination)
        print(destination)
        return 0
    finally:
        temporary.unlink(missing_ok=True)


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    try:
        sys.exit(main())
    except (OSError, subprocess.SubprocessError, KeyboardInterrupt):
        sys.exit(1)
