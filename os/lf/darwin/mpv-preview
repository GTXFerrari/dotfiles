#!/usr/bin/env python3
"""Play one muted mpv preview in the owning lf client's Kitty preview pane."""

import base64
from collections import deque
import contextlib
import ctypes
import fcntl
import json
from multiprocessing.shared_memory import SharedMemory
import os
from pathlib import Path
import re
import select
import signal
import struct
import subprocess
import sys
import termios
import uuid

HERE = Path(__file__).resolve().parent
APC = re.compile(rb"\x1b_G([^\x1b]*)\x1b\\")
CURSOR = re.compile(rb"\x1b\[(\d*);(\d*)[Hf]")

if sys.platform == "darwin":
    LIBPROC = ctypes.CDLL("/usr/lib/libproc.dylib")
    LIBPROC.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64,
                                   ctypes.c_void_p, ctypes.c_int]
    LIBPROC.proc_pidinfo.restype = ctypes.c_int
    # struct proc_bsdinfo from <sys/proc_info.h>; the last two fields are
    # the start time in seconds and microseconds. No ps subprocess per frame.
    BSDINFO = struct.Struct("=12I48s6IQQ")


def identity(pid):
    if not isinstance(pid, int) or pid <= 0:
        return None
    if sys.platform == "darwin":
        info = ctypes.create_string_buffer(BSDINFO.size)
        if LIBPROC.proc_pidinfo(pid, 3, 0, info, BSDINFO.size) != BSDINFO.size:
            return None
        fields = BSDINFO.unpack(info.raw)
        if fields[1] == 5:  # SZOMB: an exited process may not be reaped yet.
            return None
        return f"{fields[-2]}-{fields[-1]}"
    try:
        # starttime prevents a reused PID from inheriting another lf's player.
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def session():
    owner = int(os.environ.get("id", "0"))
    if owner <= 0 or not (birth := identity(owner)):
        raise ValueError("mpv previews require a live lf client")
    # macOS's long TMPDIR can exceed the Unix socket path limit for mpv IPC.
    root = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/lf-mpv-{os.getuid()}")
    root = root / "lf-mpv-preview" / f"{owner}-{birth}"
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    return owner, birth, root


@contextlib.contextmanager
def locked(path):
    with path.open("a") as gate:
        fcntl.flock(gate, fcntl.LOCK_EX)
        yield


def read_state(root):
    try:
        return json.loads((root / "state.json").read_text())
    except (OSError, ValueError):
        return {}


def write_state(root, state):
    temporary = root / f"state-{os.getpid()}.tmp"
    temporary.write_text(json.dumps(state))
    temporary.replace(root / "state.json")


def start(source, width, height, x, y):
    if min(width, height) <= 0 or min(x, y) < 0:
        raise ValueError("preview pane must have positive dimensions")
    owner, birth, root = session()
    # On macOS /dev/tty is resolved again by the driver on each write, so a
    # detached process needs the concrete slave device, even with an inherited
    # descriptor. Resolve it once at startup, never in the playback loop.
    if sys.platform == "darwin":
        device = subprocess.check_output(
            ["/bin/ps", "-p", str(owner), "-o", "tty="], text=True,
        ).strip()
        if not device or device == "??" or "/" in device:
            raise ValueError("lf has no controlling terminal")
        tty_path = f"/dev/{device}"
    else:
        tty_path = os.readlink(f"/proc/{owner}/fd/0")
    with open(tty_path, "wb", buffering=0) as tty:
        rows, cols, px, py = struct.unpack(
            "HHHH", fcntl.ioctl(tty, termios.TIOCGWINSZ, b"\0" * 8)
        )
        if not rows or not cols or not px or not py:
            raise ValueError("terminal does not report pixel dimensions")
        source = str(Path(source).resolve())
        stat = Path(source).stat()
        geometry = [width, height, x, y, round(width * px / cols), round(height * py / rows)]
        key = [source, stat.st_size, stat.st_mtime_ns, *geometry]
        with locked(root / "control.lock"):
            state = read_state(root)
            if (state.get("key") == key and state.get("birth")
                    and identity(state.get("worker", 0)) == state["birth"]):
                return
            token = uuid.uuid4().hex
            state = dict(token=token, key=key, owner=owner, owner_birth=birth,
                         geometry=geometry,
                         image_id=int(token[:7], 16) + 1)
            write_state(root, state)
            # No inherited lf preview pipe: lf must see EOF immediately.
            with (root / "player.log").open("ab") as log:
                worker = subprocess.Popen(
                    [sys.executable, str(HERE / "mpv-preview"), "run", str(root),
                     token, str(tty.fileno())],
                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=log,
                    start_new_session=True, close_fds=True, pass_fds=(tty.fileno(),),
                )
            state.update(worker=worker.pid, birth=identity(worker.pid))
            write_state(root, state)


def stop():
    _, _, root = session()
    with locked(root / "control.lock"):
        write_state(root, {})
        # Wait for the old player and its final graphics deletion before a new
        # static preview can draw. Queued stale workers check their token first.
        with locked(root / "render.lock"):
            pass


def current(root, token, state):
    return (read_state(root).get("token") == token
            and identity(state["owner"]) == state["owner_birth"])


def discard_snapshot(snapshot):
    # Kitty normally unlinks the snapshot as soon as it has read the frame.
    with contextlib.suppress(FileNotFoundError):
        snapshot.unlink()


def run(root, token, tty_fd):
    # Inherit an open tty descriptor: macOS has no /proc/<pid>/fd, and a
    # detached worker cannot reopen /dev/tty without a controlling terminal.
    with os.fdopen(tty_fd, "wb", buffering=0) as tty, locked(root / "render.lock"):
        state = read_state(root)
        if state.get("token") != token or not current(root, token, state):
            return
        width, height, x, y, px, py = state["geometry"]
        image_id = state["image_id"]
        command = [
            "mpv", "--no-config", "--load-scripts=no", "--terminal=no",
            "--input-terminal=no", "--input-default-bindings=no", "--audio=no",
            "--sub=no", "--osc=no", "--osd-level=0", "--profile=sw-fast",
            # Automatic zimg threading can leave vertical seams in Kitty RGB
            # output. One scaling thread keeps the smoke WebM clean at full FPS.
            "--zimg-threads=1",
            "--hwdec=auto-copy", "--vd-lavc-threads=2", "--vo=kitty",
            "--vo-kitty-config-clear=no", "--vo-kitty-alt-screen=no",
            "--vo-kitty-use-shm=yes", f"--vo-kitty-cols={width}",
            f"--vo-kitty-rows={height}", f"--vo-kitty-width={px}",
            f"--vo-kitty-height={py}", "--video-align-y=-1",
            "--start=0", "--ab-loop-a=0", "--ab-loop-b=20",
            "--ab-loop-count=inf", "--loop-file=inf",
            f"--script={HERE / 'preview-midpoint.lua'}",
            f"--input-ipc-server={root / 'mpv.sock'}", "--", state["key"][0],
        ]
        snapshots = deque()
        player = subprocess.Popen(command, stdin=subprocess.DEVNULL,
                                  stdout=subprocess.PIPE, close_fds=True)
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
        try:
            buffer = b""
            row, col = y + 1, x + 1
            while player.poll() is None and current(root, token, state):
                ready, _, _ = select.select([player.stdout], [], [], 0.05)
                if not ready:
                    continue
                data = os.read(player.stdout.fileno(), 65536)
                if not data:
                    break
                buffer += data
                while match := APC.search(buffer):
                    positions = CURSOR.findall(buffer[:match.start()])
                    if positions:
                        r, c = positions[-1]
                        row, col = y + max(1, int(r or 0)), x + max(1, int(c or 0))
                    graphics = match[1]
                    buffer = buffer[match.end():]
                    # Only relay frame packets. mpv's normal startup/exit
                    # sequences alter cursor/mouse modes owned by lf.
                    if not graphics.startswith(b"a=T,"):
                        continue
                    if not current(root, token, state):
                        break
                    graphics = graphics.replace(b"a=T,", f"a=T,i={image_id},".encode(), 1)
                    # A shared-memory packet is already complete. mpv 0.41
                    # marks it m=1, which Kitty treats as an unfinished chunk.
                    graphics = graphics.replace(b",m=1;", b",m=0;", 1)
                    header, payload = graphics.split(b";", 1)
                    # Kitty unlinks received SHM objects. Give it a unique
                    # snapshot so it cannot unlink mpv's next frame or read
                    # pixels while the decoder is replacing them.
                    name = base64.b64decode(payload).lstrip(b"/").decode()
                    try:
                        frame = SharedMemory(name=name, track=False)
                    except FileNotFoundError:
                        continue
                    # Disable Python's tracker: this worker and Kitty own
                    # the shared-memory lifetimes.
                    try:
                        if sys.platform == "darwin":
                            # Darwin permits ftruncate only once per SHM object.
                            # mpv sizes it every frame and expects its consumer
                            # to unlink the name. Keeping it makes alternate
                            # frames fail. Unlink immediately after mapping;
                            # our mapping keeps these pixels alive while mpv
                            # creates a fresh object for the next frame.
                            with contextlib.suppress(FileNotFoundError):
                                frame.unlink()
                        snapshot = SharedMemory(
                            name="lf-mpv-" + uuid.uuid4().hex[:16],
                            create=True, size=frame.size, track=False,
                        )
                        snapshots.append(snapshot)
                        try:
                            snapshot.buf[:] = frame.buf
                        finally:
                            snapshot.close()
                    finally:
                        frame.close()
                    while len(snapshots) > 4:
                        discard_snapshot(snapshots.popleft())
                    payload = base64.b64encode(("/" + snapshot.name).encode())
                    graphics = header + b";" + payload
                    packet = (f"\x1b7\x1b[{row};{col}H\x1b_G".encode()
                              + graphics + b"\x1b\\\x1b8")
                    # Shared memory keeps the entire packet tiny; one write
                    # saves/restores the cursor without disturbing lf input.
                    os.write(tty.fileno(), packet)
        finally:
            if player.poll() is None:
                player.terminate()
                try:
                    player.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    player.kill()
                    player.wait()
            player.stdout.close()
            for snapshot in snapshots:
                discard_snapshot(snapshot)
            with contextlib.suppress(OSError):
                os.write(tty.fileno(), f"\x1b_Ga=d,d=I,i={image_id},q=2\x1b\\".encode())


def main():
    if sys.argv[1] == "start":
        start(sys.argv[2], *(int(v) for v in sys.argv[3:7]))
    elif sys.argv[1] == "stop":
        stop()
    elif sys.argv[1] == "run":
        run(Path(sys.argv[2]), sys.argv[3], int(sys.argv[4]))
    else:
        raise ValueError("expected start, stop, or run")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"lf mpv preview: {error}", file=sys.stderr)
        sys.exit(1)
